# Supabase project API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres (pooled for app runtime, direct for migrations)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres

# Optional real AI provider. The MVP uses MockAIProvider without this.
OPENAI_API_KEY=
